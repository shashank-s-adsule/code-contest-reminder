{
  "manifest_version": 3,
  "name": "Contest Reminder",
  "version": "1.0.0",
  "description": "Never miss a Codeforces, LeetCode, CodeChef, or AtCoder contest again.",

  "permissions": [
    "notifications",
    "storage",
    "alarms"
  ],

  "host_permissions": [
    "https://codeforces.com/*",
    "https://leetcode.com/*",
    "https://www.codechef.com/*",
    "https://atcoder.jp/*",
    "https://practiceapi.geeksforgeeks.org/*"
  ],

  "background": {
    "service_worker": "background/worker.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },

  "options_page": "options/options.html",

  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
